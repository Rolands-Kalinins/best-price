{
  "name": "bestprice",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "db:start": "npx --yes supabase@2.122.0 start",
    "db:stop": "npx --yes supabase@2.122.0 stop",
    "db:reset": "npx --yes supabase@2.122.0 db reset",
    "db:status": "npx --yes supabase@2.122.0 status",
    "db:pull": "node scripts/db-pull.mjs",
    "release:plan": "node scripts/release.mjs plan",
    "release:check": "node scripts/release.mjs check"
  }
}
